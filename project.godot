; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Presentation"
run/main_scene="uid://cpc5hoelqfbu5"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/Placeholders/icon.svg"

[autoload]

GameManager="*res://autoload/game_manager.gd"
ComposureManager="*res://autoload/composure_manager.gd"
VirusManager="*res://autoload/virus_manager.gd"
ScoreManager="*res://autoload/score_manager.gd"
DifficultyDirector="*res://autoload/difficulty_director.gd"
LagManager="*res://autoload/lag_manager.gd"
PopupDirector="*res://autoload/popup_director.gd"
MessageManager="*res://autoload/message_manager.gd"
SlideManager="*res://autoload/slide_manager.gd"
FxLayer="*res://autoload/fx_layer.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

targets=""

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
